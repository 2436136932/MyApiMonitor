{
  "manifest_version": 3,
  "name": "MyApiMonitor",
  "version": "1.0.0",
  "description": "多供应商 API 余额与用量监控",
  "permissions": ["storage"],
  "host_permissions": [
    "https://api.deepseek.com/*",
    "https://platform.deepseek.com/*",
    "https://api.stepfun.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
